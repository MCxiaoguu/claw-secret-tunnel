{
  "name": "@MCxiaoguu/secret-tunnel",
  "version": "0.1.1",
  "description": "One-Time Secret Tunnel — one-time, never-stored, out-of-band secret hand-off plugin for OpenClaw",
  "type": "module",
  "license": "MIT",
  "author": "MCxiaoguu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MCxiaoguu/claw-secret-tunnel.git"
  },
  "homepage": "https://github.com/MCxiaoguu/claw-secret-tunnel#readme",
  "bugs": {
    "url": "https://github.com/MCxiaoguu/claw-secret-tunnel/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "secret",
    "credential",
    "api-key",
    "one-time",
    "ephemeral",
    "out-of-band",
    "security",
    "cloudflare",
    "cloudflared",
    "quick-tunnel",
    "tailscale"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.2.12"
    },
    "build": {
      "openclawVersion": "2026.2.12"
    }
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "npm run build && node demo/run-demo.mjs"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
